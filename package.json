{
  "name": "mongo-updown",
  "version": "1.0.0",
  "description": "mongo-updown is an opinionated MongoDB migration tool featuring: - up/down scripts - version aware - written in TypeScript",
  "license": "ISC",
  "author": "",
  "bin": {
    "mongo-updown": "./dist/cli/bin.js"
  },
  "type": "module",
  "imports": {
    "#Common/*": {
      "development": "./src/common/*.ts",
      "default": "./dist/common/*.js"
    },
    "#Cli/*": {
      "development": "./src/cli/*.ts",
      "default": "./dist/cli/*.js"
    },
    "#Config/*": {
      "development": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#Migrations/*": {
      "development": "./src/migrations/*.ts",
      "default": "./dist/migrations/*.js"
    },
    "#Db/*": {
      "development": "./src/db/*.ts",
      "default": "./dist/db/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "pretest": "node test/setup.ts",
    "test": "node --conditions=development --test \"test/**/*.spec.ts\"",
    "posttest": "node test/teardown.ts"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.5",
    "mongodb": "7.6.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "mongodb": "^7.0.0"
  }
}
