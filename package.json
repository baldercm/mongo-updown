{
  "name": "mongo-updown",
  "version": "1.0.0",
  "description": "Opinionated MongoDB migration tool: version-aware up/down scripts, pre/post deployment phases, opt-in transactions, and an append-only audit trail.",
  "keywords": [
    "cli",
    "database",
    "migration",
    "migrations",
    "mongodb",
    "typescript"
  ],
  "homepage": "https://github.com/baldercm/mongo-updown#readme",
  "bugs": {
    "url": "https://github.com/baldercm/mongo-updown/issues"
  },
  "license": "MIT",
  "author": "Bálder Carraté",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baldercm/mongo-updown.git"
  },
  "bin": {
    "mongo-updown": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#Common/*": {
      "development": "./src/common/*.ts",
      "default": "./dist/common/*.js"
    },
    "#Cli/*": {
      "development": "./src/cli/*.ts",
      "default": "./dist/cli/*.js"
    },
    "#Config/*": {
      "development": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#Migrations/*": {
      "development": "./src/migrations/*.ts",
      "default": "./dist/migrations/*.js"
    },
    "#Db/*": {
      "development": "./src/db/*.ts",
      "default": "./dist/db/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "pretest": "node test/setup.ts",
    "test": "node --conditions=development --test \"test/**/*.spec.ts\"",
    "posttest": "node test/teardown.ts"
  },
  "dependencies": {
    "chalk": "6.0.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.5",
    "mongodb": "7.6.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "mongodb": "^7.0.0"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
